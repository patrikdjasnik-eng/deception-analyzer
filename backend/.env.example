# Create an Argon2id password hash with:
# python -c "from argon2 import PasswordHasher; import getpass; print(PasswordHasher().hash(getpass.getpass()))"
# Generate a signing key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
RABBITHOLLOW_ADMIN_PASSWORD_HASH=
RABBITHOLLOW_SESSION_SECRET=
RABBITHOLLOW_SESSION_COOKIE_SECURE=false
RABBITHOLLOW_LLM_BASE_URL=http://127.0.0.1:11434
RABBITHOLLOW_LLM_MODEL=qwen2.5-coder:7b
RABBITHOLLOW_LLM_MAX_OUTPUT_TOKENS=1024
